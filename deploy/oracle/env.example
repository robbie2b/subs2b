# Copiaza acest fisier ca ".env" (cp env.example .env), apoi completeaza valorile cu nano .env
# Fisierul .env NU se pune pe GitHub si nu se trimite nimanui.

# Adresa serverului, fara https:// (de ex. subs2b-robbie.duckdns.org)
DOMAIN=

# Aceeasi valoare ca pe Render (Environment -> DATABASE_URL): baza Supabase, deci aceeasi configuratie si acelasi UUID
DATABASE_URL=
