{
  "name": "subs2b",
  "version": "1.0.0",
  "description": "Stremio & Nuvio subtitle aggregator: searches several providers and puts the subtitle that best matches the playing file first.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "tsx test/providerValidation.test.ts && tsx test/persistenceStorage.test.ts && tsx test/decodeRelease.test.ts && tsx test/subsroPick.test.ts && tsx test/scorer.test.ts && tsx test/fallback.test.ts && tsx test/vttConvert.test.ts"
  },
  "keywords": [
    "stremio",
    "stremio-addon",
    "subtitles",
    "nuvio",
    "opensubtitles",
    "subdl",
    "subsource",
    "subs.ro"
  ],
  "author": "robbie2b",
  "license": "GPL-3.0",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "iconv-lite": "^0.6.3",
    "lru-cache": "^11.0.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
