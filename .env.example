# Server
PORT=7000
HOST=0.0.0.0
# Public URL where the addon is reachable (e.g. https://subs2b.onrender.com).
# Optional: it is detected from the request when empty.
BASE_URL=

# Storage for user configurations (UUID + password + settings).
# With DATABASE_URL (PostgreSQL: Render, Supabase, Neon...) they survive redeploys.
# Without it they are written to ./data/configurations.json
DATABASE_URL=
# Custom folder for the local file (optional)
DATA_DIR=

# API keys are NOT set here: each user enters their own keys in the configuration page (Services tab).

# OpenSubtitles addons imported in the configuration page run:
#   parallel (default)  together with the direct OpenSubtitles integration
#   fallback            only if the direct integration fails
OPENSUBTITLES_ADDON_MODE=parallel

# Rate limiting for the subtitles endpoint
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=150
